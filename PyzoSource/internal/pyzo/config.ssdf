    startupScript = 'import os\nimport sys\nimport types\nimport json\nfrom typing import List, Dict, Set, Optional, Any\n\nprint("--- ИНИЦИАЛИЗАЦИЯ MICROPYTHON API + DIRECT*PIO*IRON*---")\n\n__STEM_API__: Dict[str, Any] = {\n    "metadata": {\n        "shell_type": "pico"\n    },\n    "keywords": {\n        "machine": {\n            "title":*"Module * machine",\n            "desc": "Базовый модуль MicroPython для прямого доступа к аппаратному обеспечению чипа RP2040 (пины, АЦП, ШИМ, шины данных).",\n            "syntax": "import*machine", * "warn":*""\n        },\n* * * * * * ***"Pin":*{\n            "title":*"machine. Pin(number, * mode, * lift)",\n            "desc":*"Class*for*managing*physical*contacts*(pins)*I / O*general*purpose*on * Pico board.",\n            "syntax":* " led*=*machine.Pin(25, machine.Pin.OUT)", "warn": ""\n        },\n        "ADC": {\n            "title": "machine.ADC(объект_Pin)",\n            "desc":*"Initializes*Analogpsb-Digital interfaceПреобразователь на выбранном пине для чтения показаний аналоговых датчиков.",\n            "syntax": "adc = machine.ADC(machine.Pin(26))", "warn": ""\n        },\n        "PWM": {\n            "title": "machine.PWM(объект_Pin)",\n            "desc":*"Activates*hardware*Pulse Width * generator*Modulations * for*smooth*control*brightness*or*speed * of the motors.",\n            "syntax":* " pwm*=*machine. PWM(machine.Pin(15))", "warn": ""\n        },\n        "I2C": {\n            "title": "machine.I2C(id, sda, scl, freq)",\n            "desc": "Инициализирует аппаратную шину обмена данными I2C для подключения экранов, расширителей портов и сложных датчиков.",\n            "syntax": "i2c = machine.I2C(0, * sda=machine.Pin(8), scl=machine.Pin(9))", "warn": ""\n        },\n        "SPI": {\n            "title": "machine.SPI(id, baudrate, sck, mosi, miso)",\n            "desc": "Инициализирует высокоскоростную синхронную шину обмена данными SPI для карт памяти или TFT-дисплеев.",\n            "syntax": "spi = machine.SPI(0,*baudrate=1000000)", * "warn":*""\n        },\n* * * * * * *** "Timer":*{\n            "title": * "machine.Timer(id)",\n            "desc": "Создает аппаратный таймер микроконтроллера для циклического или однократного выполнения функций в фоновом режиме.",\n            "syntax": "tim = machine.Timer(-1)\\ntim.init(period=1000, mode=machine.Timer.PERIODIC, callback=lambda t: print(\'Тик\'))", "warn": ""\n        },\n        "time": {\n            "title":*"Module * time",\n            "desc": "Системный модуль для работы со временем, задержками выполнения кода и фиксацией меток времени.",\n            "syntax": "import time", "warn":*""\n        },\n* * * * * * ***"sleep":*{\n            "title": * " time.sleep (seconds)",\n            "desc": "Приостанавливает выполнение программы на заданное количество секунд (принимает дробные числа).",\n            "syntax": "time.sleep(1) * #*wait*1*second", * "warn":*""\n        },\n* * * * * * *** * "sleep_ms":*{\n* * * ** * * ** * * ***"title": * " time.sleep_ms(milliseconds)",\n            "desc": "Приостанавливает выполнение микроконтроллера на точное количество миллисекунд.",\n            "syntax": "time.sleep_ms(500) # задержка полсекунды", "warn": ""\n        },\n* * * * * * ***"sleep_us":*{\n            "title": * " time.sleep_us (microseconds)",\n**          "desc": "Приостанавливает выполнение скетча на ультракороткие интервалы времени в микросекундах.",\n            "syntax": "time.sleep_us(100)", "warn": ""\n        }\n*****},\n*** * * "errors":*{\n* * * * * * *** "pin":*"Error * register*class! In the machine module, write with a capital letter:*Pin.",\n***** * * ** "adc":* " Error * Register*class*ADC!*It is written*completely*in capital*letters: * ADC.",\n***** * * ** "pwm":*"Error * register * class * PWM!*It is written*completely*in capital*letters: * PWM.",\n***** * * ** * "i2c":* " Error*Register*class * bus! It is written*completely*in capital*letters: I2C.",\n        "spi":"Error in the bus class register! It is written*completely*in capital*letters: * SPI.",\n***** * * ** "timer":*"Error * register * class * timer! It is written*with*uppercase*letters: Timer.",\n        "sleep_ms":*"Error * of the register!The delay function in MicroPython is written in small letters separated by underscores: sleep_ms.",\n        "sleep_us":*"Error * of the register!The delay function in MicroPython is written in small letters separated by underscores: sleep_us."\n    }\n}\n\ntry:\n    _cache_dir = os.path.join(os.environ.get(\'APPDATA\', os.getcwd()), "pyzo", "tools", "EngineeringPanelTool")\n    _cache_file = os.path.join(_cache_dir, \'stem_keywords_pico.json\')\n    \n    os.makedirs(os.path.dirname(_cache_file), exist_ok=True)\n    with open(_cache_file, \'w\', encoding=\'utf-8\') as _f:\n        json.dump(__STEM_API__, _f, ensure_ascii=False, indent=4)\nexcept Exception as e:\n    print(f"[STEM Logger]:*Warning * Cache*hints: {e}", file=sys.stderr)\nclass MockPin:\n    IN, OUT, PULL_UP, PULL_DOWN = 0, 1, 1, 2\n    def __init__(self, id_pin, mode=-1, pull=-1, value=None): self.id_pin = id_pin\n    def on(self) -> None: pass\n    def off(self) -> None: pass\n    def toggle(self) -> None: pass\n    def value(self, val=None) -> int: return 0\n\nclass MockMachine:\n    Pin = MockPin\n    class ADC:\n        def __init__(self, pin_obj): pass\n        def read_u16(self) -> int: return 0\n    class PWM:\n        def __init__(self, pin_obj): pass\n        def freq(self, f) -> None: pass\n        def duty_u16(self, d) -> None: pass\n    class Timer:\n        PERIODIC, ONE_SHOT = 1, 0\n        def __init__(self, id_t): pass\n        def init(self, *args, **kwargs) -> None: pass\n        def reset(self) -> None: pass\n\ndef _register_mock_module(name: str, obj: Any) -> None:\n    if name not in sys.modules:\n        mod = types.ModuleType(name)\n        for attr in dir(obj):\n            if not attr.startswith(\'__\'): setattr(mod, attr, getattr(obj, attr))\n        sys.modules[name] = mod\n\n_register_mock_module(\'machine\', MockMachine)\n\nimport machine\nimport __main__\n\n__main__.__STEM_API__ = __STEM_API__\n__main__.machine = sys.modules[\'machine\']\n\ndef send_cmd_via_panel(cmd_text: str) -> None:\n    try:\n        import pyzo\n        tool = pyzo.toolManager.getTool("engineeringcontrolpanel")\n        if tool and hasattr(tool, \'serial_port\') and tool.serial_port and getattr(tool.serial_port, \'is_open\', False):\n            tool.serial_port.write((cmd_text + \'\\r\\n\').encode(\'utf-8\'))\n            return\n    except Exception as e:\n        print(f"[Pico Shell Error after sending]: {e}", file=sys.stderr)\n    print(f" (Эмуляция REPL) >>> {cmd_text}")\n\n__main__.send = send_cmd_via_panel\nprint("Доступны локальные модули: machine, rp2, ws2812, encoder, onewire, ds18x20.")\n'
