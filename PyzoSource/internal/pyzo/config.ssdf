    startupScript = 'import os\nimport sys\nimport types\nimport json\nfrom typing import List, Dict, Set, Optional, Any\n\nprint("--- ИНИЦИАЛИЗАЦИЯ КИБЕРНЕТИЧЕСКОГО API ROBOTS*(TRICK) ---")\n\n__STEM_API__: Dict[str, Any] = {\n    "metadata": {\n        "shell_type": "trik"\n    },\n    "keywords": {\n        "trik": {\n            "title":*"Package * trik",\n            "desc": "Корневой системный пакет робототехнической платформы ТРИК для низкоуровневой связи с контроллером.",\n            "syntax": "import trik", "warn": ""\n        },\n* * * * * * *** "brick":*{\n            "title":* "Object * brick",\n***** * * ***** * * "desc":*"Main*virtual*controller * robot*TRICK. Предоставляет прямой доступ ко всем подключенным моторам, датчикам и периферии.",\n            "syntax": "brick.motor(\'M1\').setPower(100)", * "warn":*""\n        },\n* * * * * * ***"motor":*{\n            "title": * " brick. motor(\'port\')",\n            "desc":Initializes the power port for controlling the robot's executive motor.*Accepts*ports*\ ' M1\', * \ ' M2\', * \'M3\', * \'M4\'.",\n            "syntax":* " brick. motor(\'M1\')", * "warn":*""\n        },\n* * * * * * ***"SetPower":*{\n            "title":*"motor. SetPower",\n            "desc":*"Sets the * speed*and*direction*of rotation*of the motor. Accepts*power range * from*-100*(full*backward)*up to * 100*(full speed ahead).",\n            "syntax": * " brick. motor(\'M1\'). SetPower(80);", * "warn":*""\n        },\n* * * * * * ***"power":*{\n            "title":* " motor.power ()",\n****** * * * * ***"desc": "Возвращает текущее установленное значение мощности выбранного силового двигателя в диапазоне от -100 до 100.",\n            "syntax": "int current_p = brick.motor(\'M1\'). power ()", * "warn":*""\n        },\n* * * * * * ** * "brake":*{\n* * * ** * * * * * ****"title":* " motor.brake()",\n            "desc": "Посылает команду мгновенной динамической блокировки обмоток двигателя для резкой остановки робота на месте.",\n            "syntax": "brick.motor(\'M1\').brake()",\n            "warn": "Для свободного наката колес используйте отключение питания вместо brake()."\n        },\n        "sensor": {\n       **** * * "title": * " brick. sensor (\'port\')",\n            "desc":*"Initializes*the selected * analog*or * digital * port*for*reading * sensor readings*.*Accepts*ports*\ ' D1\', * \ ' D2\', * \ ' A1\', * \'A2\'.",\n            "syntax":* " brick. sensor(\'A1\')", * "warn":*""\n        },\n* * * * * * ***"read":*{\n            "title":*"sensor. read ()",\n            "desc":*"Reads*current*physical*value*(distance, * illumination,*angle of * rotation) с выбранного датчика робота.",\n            "syntax": "int distance = brick.sensor(\'D1\').read()", "warn": ""\n        },\n* * * * * * ** * "display":*{\n            "title": * "Object * brick. display ()",\n            "desc": "Интерфейс управления встроенным ЖК-экраном блока управления ТРИК для вывода графики, текста или отладочных логов.",\n            "syntax": "brick.display().addLabel (\'The robot is now ready\', 10, 10)", "warn": * " "\n        },\n* * * * * * ***"addLabel":*{\n** * *          "title": * " display.addLabel(text, * x, * y)",\n            "desc": "Выводит текстовую строку на экран блока управления ТРИК по заданным координатам пикселей X и Y.",\n            "syntax": "brick.display().addLabel(\'STEM'TRICK\', 20, 40)",\n            "warn":"Don't forget to call redraw () to force a screen refresh."\n        },\n        "redraw": {\n            "title": "display.redraw()",\n            "desc": "Принудительно обновляет видеобуфер экрана ТРИК, отрисовывая все ранее добавленные надписи и графические фигуры.",\n            "syntax": "brick.display().redraw()", * "warn":*""\n        },\n* * * ******"FORWARD":*{"title":* "Constant*FORWARD", * "desc": "Направление вращения сервопривода вперед.", "syntax": "brick.motor(\'M1\').setPower(FORWARD)", "warn": ""},\n        "BACKWARD":*{"title":* "Constant*BACKWARD", * "desc": "Направление вращения сервопривода назад (реверс).", "syntax": "brick.motor(\'M1\').setPower(BACKWARD)", "warn": ""},\n        "M1":*{"title":*"Port"Motor*M1", * "desc": "Первый силовой разъем для подключения левого или правого ведущего двигателя.", "syntax": "brick.motor(\'M1\')", "warn": ""},\n     ***"A1":*{"title":*"Sensor Port*A1", * "desc": "Первый аналоговый разъем для подключения датчиков освещенности или гироскопов.", "syntax": "brick.sensor(\'A1\')", "warn":*""} \n*****},\n*** * * "errors":*{\n***** * * * * * "setpower":* " Error * Case*letters! In the * cybernetic*core*TRICK*method*is written*in the * camelCase * style:*SetPower*(P* - * uppercase).",\n        "addlabel":*"Error * Case*letters! In the * TRICK * system, the * screen*method is written*in the * camelCase * style:*addLabel*(L* - * uppercase).",\n        "brick":*"Error * of the register! System*controller * TRICK*in * Python scripts*always*write*with*lowercase*letters:*brick."\n*****}\n}\n\n#*INFORMATION*Bridge: Фиксация структурированного JSON-кэша подсказок через изолированный AppData\ntry:\n    _cache_dir = os.path.join(os.environ.get(\'APPDATA\', os.getcwd()), "pyzo",*"tools", * "EngineeringPanelTool")\n****_cache_file*=*os. path. join(_cache_dir, * \ ' stem_keywords_trik.json\')\n    \n    os.makedirs(os.path.dirname(_cache_file), exist_ok=True)\n    with open(_cache_file, \'w\', encoding=\'utf-8\') as _f:\n        json.dump(__STEM_API__, _f, ensure_ascii=False, indent=4)\nexcept Exception as e:\n    print(f"[STEM Logger]:*Warning * Cache*hints: {e}", file=sys.stderr)\n\n\nclass MockDisplay:\n    def addLabel(self, text: str, x: int, y: int) -> None: pass\n    def redraw(self) -> None: pass\n    def clear(self) -> None: pass\n\n\nclass MockMotor:\n    def setPower(self, power: int) -> None: pass\n    def power(self) -> int: return 0\n    def brake(self) -> None: pass\n\n\nclass MockSensor:\n    def read(self) -> int: return 0\n\n\nclass MockBrick:\n    def __init__(self) -> None:\n        self._display = MockDisplay()\n        \n    def motor(self, port: str) -> MockMotor: return MockMotor()\n    def sensor(self, port: str) -> MockSensor: return MockSensor()\n    def display(self) -> MockDisplay: return self._display\n\n\nif \'trik\' not in sys.modules:\n    _trik_mod = types.ModuleType(\'trik\')\n    setattr(_trik_mod, \'FORWARD\', 1)\n    setattr(_trik_mod, \'BACKWARD\', -1)\n    setattr(_trik_mod, \'STOP\', 0)\n    setattr(_trik_mod, \'BRAKE\', 2)\n    sys.modules[\'trik\'] = _trik_mod\n\nimport trik\nimport __main__\n\n__main__.__STEM_API__ = __STEM_API__\n__main__.brick = MockBrick()\n__main__.FORWARD = 1\n__main__.BACKWARD = -1\n\nprint("Виртуальное кибернетическое ядро ТРИК успешно развернуто.")\nprint("Доступны локальные объекты управления: brick.motor(), brick.sensor(), brick.display().")\n'
