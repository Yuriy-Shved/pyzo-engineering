    startupScript = 'import os\nimport sys\nimport types\nimport json\nfrom typing import List, Dict, Set, Optional, Any\n\nprint("--- ИНИЦИАЛИЗАЦИЯ РОБОТОТЕХНИЧЕСКОГО API RASPBERRY PI - - -")\n\n__STEM_API__: Dict[str, Any] = {\n    "metadata": {\n        "shell_type": "pi"\n    },\n    "keywords": {\n        "GPIO": {\n            "title":*"Module * RPi. GPIO",\n            "desc":*"Basic*library*for * direct*low-level*PIN management * I / O*(GPIO) одноплатного компьютера Raspberry Pi.",\n            "syntax": "import RPi.GPIO as GPIO", "warn": ""\n        }, \n***** * * **"setmode":*{\n            "title": * " GPIO. setmode(mode)",\n            "desc":*"Sets the * method * of numbering*physical*contacts*(pins)*on the * board*Raspberry Pi. Принимает режимы GPIO.BCM или GPIO.BOARD.",\n            "syntax": "GPIO.setmode(GPIO.BCM | GPIO.BOARD)", "warn": ""\n        },\n* * * * * * ***"setup":*{\n            "title": * " GPIO. setup (pin, * mode)",\n            "desc":*"Configures*the selected*I / O port*Raspberry Pi for a specific task:output of a signal (GPIO. OUT) или чтение датчика (GPIO.IN).",\n            "syntax": "GPIO.setup(PIN, GPIO.IN | GPIO.OUT)", "warn": ""\n        },\n* * * * * * ***"output":*{\n            "title": * " GPIO. output (pin, * value)",\n            "desc":*"Outputs*to * the specified*pin*(configured*as * GPIO. OUT)*High*level * voltage*3.3В (GPIO.HIGH) или низкий уровень 0В (GPIO.LOW).",\n            "syntax": "GPIO.output(18, GPIO.HIGH | GPIO.LOW)", "warn":*""\n        },\n* * * * * * ***"input":*{\n            "title": * " GPIO. input (pin)",\n            "desc":"Reads the current logical state from the selected input pin.*Returns*1*(GPIO. HIGH) или 0 (GPIO.LOW).",\n            "syntax": "if GPIO.input(23) == GPIO.HIGH:", "warn": ""\n        },\n        "cleanup": {\n            "title": "GPIO.cleanup()",\n            "desc": "Освобождает все использованные в текущем скрипте пины и сбрасывает их режимы в состояние по умолчанию для защиты железа при выходе.",\n            "syntax": * "GPIO. cleanup ()", * "warn":*""\n        },\n* * * * * * *** "LED":*{\n           *"title": * " LED (pin number)",\n            "desc": "Объект высокоуровневой библиотеки gpiozero для быстрого управления обычными светодиодами без ручной настройки режимов пинов.",\n            "syntax": "led = LED(17)", * "warn":*""\n        },\n* * * * * * ***"on":*{\n            "title":* " led.on ()",\n            "desc": "Включает светодиод библиотеки gpiozero, подавая напряжение на соответствующий физический пин.",\n            "syntax": "led.on()", "warn": ""\n        },\n* * * * * * ***"off":*{\n            "title":* " led.off ()",\n***         "desc": "Вычает светодиод библиотеки gpiozero, полностью снимая напряжение с физического пина.",\n            "syntax": "led.off()", "warn": ""\n        },\n* * * * * * ***"blink":*{\n            "title": * " led. blink(vkl_time, vkl_time)",\n            "desc": "Запускает автоматическое мигание светодиода в фоновом режиме библиотеки gpiozero.",\n            "syntax": "led.blink(on_time=1, off_time=1)",\n            "warn": "Для остановки фонового мигания вызовите метод led.off()"\n        },\n        "Button": {\n          **"title": * " Button (pin number)",\n            "desc": "Объект библиотеки gpiozero для быстрого и удобного подключения тактовых кнопок и бинарных датчиков.",\n            "syntax": "button = Button(2)",*"warn":*""\n        },\n* * * * * * ** * "when_pressed":*{\n            "title": * " button.when_pressed*=*function",\n            "desc":*"Event-driven * hardware*interrupt. Автоматически выполняет указанную функцию на Python в момент зажатия физической кнопки.",\n            "syntax": "button.when_pressed*=*function_name "without a scratch",\n            "warn":*"Attention! Assign*only * the name * of the function.*You can't put * parentheses * at the * end of*."\n        },\n        "when_released": {\n            "title": "button.when_released*=*function",\n            "desc":*"Event-driven * hardware*interrupt. Автоматически выполняет функцию на Python в момент отпускания кнопки.",\n            "syntax": "button.when_released = имя_функции_без_скобок",\n            "warn": ""\n        },\n        "run_pi": {\n            "title": * " run_pi(\'имя_файла.ру\')",\n            "desc":*"Special*control*command * of the remote control.*Remotely*sends*the current*script*to the * board*Raspberry Pi по сети и запускает его через SSH.",\n            "syntax": "run_pi(\'script.py\')", "warn": ""\n        },\n* * * ******"BCM": {"title":*"Mode * GPIO. BCM", * "desc":*"Numbering*pins*by * internal*numbers * channels*processor*Broadcom*(recommended).", "syntax": "GPIO.setmode(GPIO.BCM)", "warn": ""},\n        "BOARD": {"title":*"Mode * GPIO. BOARD", * "desc": "Нумерация пинов по физическим номерам контактов на гребенке платы (от 1 до 40).", "syntax": "GPIO.setmode(GPIO.BOARD)", "warn": ""},\n* * * ******"HIGH": {"title":*"Level * GPIO. HIGH", * "desc":*"High*Digital*signal level*(логическая единица, 3.3 Вольта).", "syntax": "GPIO.output(18, GPIO.HIGH)", "warn": ""},\n        "LOW": {"title":*"GPIO.LOW level", * "desc":*"Low*Digital*signal level*(logical*zero, * 0 * Volt,*ground).", * "syntax":* " GPIO. output(18,*GPIO. LOW)", * "warn": ""}\n    },\n    "errors": {\n        "setmode":*"Error * Case*letters!The function is written in small letters:*setmode*(m* - * lowercase).", \n * * * * * * * * * "cleanup":* " Error * Case*letters!The function of clearing pins is written in small letters: cleanup.",\n        "when_pressed":*"Error * of the register! Event ─ gpiozero is written in lowercase letters separated by underscores: when_pressed.",\n        "when_released":*"Error * of the register! Event ─ gpiozero is written in lowercase letters separated by underscores: when_released."\n    }\n}\n\ntry:\n    _cache_dir = os.path.join(os.environ.get(\'APPDATA\', os.getcwd()), "pyzo", "tools", "EngineeringPanelTool")\n    _cache_file = os.path.join(_cache_dir, \'stem_keywords_pi.json\')\n    \n    os.makedirs(os.path.dirname(_cache_file), exist_ok=True)\n    with open(_cache_file, \'w\', encoding=\'utf-8\') as _f:\n        json.dump(__STEM_API__, _f, ensure_ascii=False, indent=4)\nexcept Exception as e:\n    print(f"[STEM Logger]:*Warning * Cache*hints: {e}", file=sys.stderr)\nclass MockGPIO:\n    BCM, BOARD, IN, OUT, HIGH, LOW = 11, 10, 1, 0, 1, 0\n    @staticmethod\n    def setmode(mode: int) -> None: pass\n    @staticmethod\n    def setwarnings(flag: bool) -> None: pass\n    @staticmethod\n    def setup(pin: int, mode: int, pull_up_down: int = -1) -> None: pass\n    @staticmethod\n    def output(pin: int, value: int) -> None: pass\n    @staticmethod\n    def input(pin: int) -> int: return 0\n    @staticmethod\n    def cleanup() -> None: print("[Raspberry Pi]: GPIO pins cleared successfully.")\n\nclass*MockGPIOZeroLED:\n****def*__init__(self, * pin:*int)*->*None: self.pin = pin\n    def on(self) -> None: pass\n    def off(self) -> None: pass\n    def blink(self, on_time: float = 1, off_time: float = 1) -> None: pass\n\nclass MockGPIOZeroButton:\n    def __init__(self, pin: int) -> None:\n        self.pin = pin\n        self.when_pressed = None\n        self.when_released = None\n\nif \'RPi\' not in sys.modules: \n    sys.modules[\'RPi\'] = types.ModuleType(\'RPi\')\n\nif \'RPi.GPIO\' not in sys.modules:\n    _gpio_mod = types.ModuleType(\'RPi.GPIO\')\n    for _attr in dir(MockGPIO):\n        if not _attr.startswith(\'__\'): setattr(_gpio_mod, _attr, getattr(MockGPIO, _attr))\n    sys.modules[\'RPi.GPIO\'] = _gpio_mod\n\nif \'gpiozero\' not in sys.modules:\n    _gz_mod = types.ModuleType(\'gpiozero\')\n    setattr(_gz_mod, \'LED\', MockGPIOZeroLED)\n    setattr(_gz_mod, \'Button\', MockGPIOZeroButton)\n    sys.modules[\'gpiozero\'] = _gz_mod\n\nimport RPi.GPIO as GPIO\nimport gpiozero\nimport __main__\n\n__main__.__STEM_API__ = __STEM_API__\n__main__.GPIO = GPIO\n__main__.LED = MockGPIOZeroLED\n__main__.Button = MockGPIOZeroButton\n\ndef run_pi_internally(filename: str, ip: str = "192.168.1.100", password: str = "raspberry") -> None:\n    print(f"\\n[SSH Network]:*Connecting*to * Raspberry Pi*({ip})...")\n    print(f"[SSH Launch]: Executing*file*\'{filename}\'*on*remote*board...")\n****print("[SUCCESS]: The script is already running! Логи выполнения перенаправлены в монитор.")\n\n__main__.run_pi = run_pi_internally\n\nprint("Доступны локальные модули: GPIO (RPi.GPIO), LED, Button (gpiozero).")\nprint("Команда run_pi(\'имя_файла.py\')*used*for * remote*sending * a script.")\n'
