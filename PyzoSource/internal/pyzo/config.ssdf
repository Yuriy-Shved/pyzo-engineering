    startupScript = 'import os\nimport sys\nimport json\nimport subprocess\nimport re\nimport __main__\n\nprint("--- АВТОНОМНАЯ C DEVELOPMENT ENVIRONMENT (ARDUINO) INITIALIZED*---")\n\nif*\ ' CLI_PATH\'*not*in*globals(): CLI_PATH = "arduino-cli"\nif \'BOARD_TYPE\' not in globals(): BOARD_TYPE = "arduino:avr:uno"\nif \'COM_PORT\' not in globals(): COM_PORT = "COM4"\n\n__STEM_API__ = {\n    "metadata": {\n        "shell_type": "arduino"\n    },\n    "keywords": {\n        "setup": {\n            "title": "void setup()",\n            "desc":Mandatory initialization function.Called*once*when * the microcontroller starts*.*Used*for * configuring*Pin modes*and * starting * Serial.",\n            "syntax":* " void*setup() {\\n  //*code*settings\\n}", * "warn":*""\n        },\n* * * * * * ***"loop":*{\n            "title": * " void*loop ()",\n            "desc":*"Main*infinite*loop*of the program * Arduino. Вызывается непрерывно сразу после завершения работы функции setup().",\n            "syntax": "void loop() {\\n  //*main*executable*code\\n}", * "warn":*""\n        },\n* * * * * * ***"pinMode":*{\n          **"title":* " pinMode(pin,*mode)",\n            "desc":*"Configures the * specified*digital*contact*of the * board*for*operation*as * input*(INPUT,*INPUT_PULLUP) или выхода (OUTPUT).",\n            "syntax": "pinMode(PIN_NUMBER, INPUT | OUTPUT | INPUT_PULLUP);", "warn": ""\n        },\n        "digitalWrite": {\n            "title": "digitalWrite(пин, значение)",\n            "desc":*"Provides*digital*signal*high*level*HIGH*(3.3 V*/*5V)*or*LOW*level*LOW*(0V) на выбранный контакт.",\n            "syntax": "digitalWrite(PIN_NUMBER, HIGH | LOW);", "warn": ""\n       *}, \n***** * * ** "digitalRead":*{\n            "title": * " digitalRead (pin)",\n            "desc":*"Reads the * logical*state*from the * specified * digital * pin*of the board. Returns*HIGH*or*LOW.",\n            "syntax":* " int*val*= digitalRead(PIN_NUMBER);", "warn": ""\n        },\n        "analogWrite": {\n            "title": "analogWrite(пин, значение)",\n            "desc":*"Generates * hardware*PWM signal*on*pins that * support * PWM, * for * smooth*change*яркости LED или скорости моторов.",\n            "syntax": "analogWrite(PIN_NUMBER, значение_от_0_до_255);", "warn": ""\n        }, \n***** * * ** "analogRead":*{\n            "title": * " analogRead (pin)",\n            "desc":*"Reads the * voltage*value*from the * analog*input*of the * board*using the * built-in * ADC. Возвращает значения от 0 до 1023.",\n            "syntax": "int val = analogRead(ANALOG_PIN);", "warn": ""\n  **** * * *}, \n***** * * ** "delay":*{\n            "title": * " delay (milliseconds)",\n***** * * ******"desc": "Полностью приостанавливает выполнение программы на заданное количество миллисекунд.",\n            "syntax": "delay(время_в_мс);", "warn":*"Attention!The delay function blocks the processor. Не используйте ее внутри обработчиков аппаратных прерываний."\n        },\n        "delayMicroseconds": {\n            "title": * "delayMicroseconds(microseconds)",\n            "desc": "Приостанавливает выполнение скетча на ультракороткие интервалы времени в микросекундах.",\n            "syntax": "delayMicroseconds(время_в_мкс);", "warn": ""\n        },\n* * * * * * *** "millis":*{\n            "title":* " millis ()",\n***** * * ******"desc":"Returns the number of milliseconds that have elapsed since the start of the current program. Используется для неблокирующих таймеров.",\n            "syntax": "unsigned long currentMillis = millis();", "warn": ""\n     ***}, \n***** * * **"micros":*{\n            "title": * " micros ()",\n            "desc":*"Returns*the number of * microseconds*since the * start * of the sketch.*Overflows*after approximately*70*minutes.",\n            "syntax":* " unsi gned*long*currentMicros*=*micros ();", * "warn":*""\n****** * * *}, \n***** * * ** "Serial":*{\n            "title":* "Object*Serial",\n***** * * ******"desc":*"Hardware*serial*port*for * text * data * exchange * between*the board*Arduino и компьютером (через USB-кабель).",\n            "syntax": "Serial.begin(9600);", "warn": ""\n     ***}, \n***** * * **"begin":*{\n            "title": * " Serial. begin(speed)",\n****** * * *****"desc": "Инициализирует последовательный интерфейс передачи данных и устанавливает скорость обмена в бодах.",\n            "syntax": "Serial.begin(9600 | 115200);", "warn": * " "\n        },\n* * * * * * ***"print":*{\n            "title": * " Serial. print(data) ", \n            "desc": "Выводит текстовые данные, переменные или строки в монитор последовательного порта без переноса строки.",\n            "syntax": "Serial.print(\\"Текст\\"); * or*Serial. print (variable);", * "warn":*""\n        },\n* * * * * * *** "println":*{\n* * * * * * ****** * * "title": * " Serial. println(data)",\n            "desc": "Выводит текстовые данные в монитор порта и автоматически добавляет невидимый символ переноса строки.",\n            "syntax": "Serial.println(\\"String*of text\\");", * "warn":*""\n        },\n* * * * * * ** * "available":*{\n            "title": * " Serial.available ()",\n            "desc": "Возвращает количество байт, поступивших от компьютера и уже доступных для считывания во внутреннем буфере Arduino.",\n            "syntax": "if (Serial.available() > 0) { ... }", "warn": ""\n        },\n        "read": {\n            "title": "Serial.read()",\n            "desc":"Reads the first available byte of incoming data from the Serial port buffer.*Returns*-1, * if the * buffer*is empty.",\n            "syntax":* " char*ch*=*Serial. read ();", * "warn":*""\n******* * * }, \n***** * * **"INPUT": {"title":*"INPUT mode", * "desc": "Конфигурирует пин как вход с высоким импедансом для чтения датчиков.", "syntax": "pinMode(2, INPUT);", "warn": ""},\n       *"OUTPUT": {"title":*"OUTPUT mode", * "desc": "Конфигурирует пин как выход низкой мощности (для LED, реле и т.д.).", "syntax": "pinMode(13, OUTPUT);", "warn": ""},\n  **** * * *"INPUT_PULLUP": {"title":*"Mode*INPUT_PULLUP", * "desc": "Включает внутренний подтягивающий резистор на 20кОм к шине питания.", "syntax": "pinMode(2, INPUT_PULLUP);", "warn": ""},\n        "HIGH": {"title":*"Signal * HIGH", * "desc": "Высокий логический уровень напряжения (логическая 1).", "syntax": "digitalWrite(13, HIGH);", "warn": ""},\n        "LOW": {"title":*"Signal * LOW", * "desc": "Низкий логический уровень напряжения (логический 0, земля).", "syntax": "digitalWrite(13, LOW);", "warn": ""},\n        "LED_BUILTIN":*{"title":* "Constant*LED_BUILTIN", * "desc": "Встроенный системный номер пина, к которому припаян заводской светодиод на платах.", "syntax": "pinMode(LED_BUILTIN, OUTPUT);", "warn": ""}\n    },\n    "errors": {\n        "digitalwrite":*"Error*register*letters*in*Arduino*C! Correctly:*digitalWrite*(W* - * uppercase).",\n        "pinmode":*"Error*register*letters*in*Arduino*C! Correctly:pinMode (M-uppercase).",\n        "digitalread":*"Error*register*letters*in*Arduino*C! Correctly:*digitalRead*(R* - * uppercase).",\n        "analogwrite":*"Error*register*letters*in*Arduino*C! Correctly:*analogWrite*(W* - * uppercase).",\n        "analogread":*"Error*register*letters*in*Arduino*C! Correctly:*analogRead*(R* - * uppercase).", \n * * * * * * * * * "delaymicroseconds": * " Error*Register*letters*in * Arduino*C! Correctly:delayMicroseconds (M-uppercase).",\n        "serial":*"Error * of the register! The system class is written with a capital letter:*Serial.",\n***** * * ** "led_builtin":* " Error * Register*constants! It is written*completely*in capital*letters: LED_BUILTIN.",\n        "input_pullup":*"Error * register * constants! It is written*completely*in capital*letters: INPUT_PULLUP."\n    }\n}\n\ntry:\n    _cache_dir = os.path.join(os.environ.get(\'APPDATA\', os.getcwd()), "pyzo", "tools", "EngineeringPanelTool")\n    _cache_file = os.path.join(_cache_dir, \'stem_keywords_arduino.json\')\n    \n    os.makedirs(os.path.dirname(_cache_file), exist_ok=True)\n    with open(_cache_file, \'w\', encoding=\'utf-8\') as _f:\n        json.dump(__STEM_API__, _f, ensure_ascii=False, indent=4)\nexcept Exception as e:\n    print(f"[STEM Logger]:*Warning * Cache*hints: {e}", file=sys.stderr)\ndef build_c() -> None:\n    current_cli = globals().get(\'CLI_PATH\', CLI_PATH)\n    current_board = globals().get(\'BOARD_TYPE\', BOARD_TYPE)\n    editor_filename = os.environ.get(\'PYZO_ACTIVE_FILE\', \'\')\n    build_path = os.environ.get(\'ARDUINO_BUILD_PATH\', \'\')\n    \n    if not editor_filename:\n        print("[Ошибка]: Open*and * save*file!", * file=sys. stderr)\n        return\n        \n    print(f"\\n[Compilation]: Сборка файла {os.path.basename(editor_filename)}...")\n    \n    cli_dir = os.path.dirname(current_cli)\n    yaml_config = os.path.join(cli_dir, "arduino-cli.yaml")\n    config_args = ["--config-file", yaml_config] if os.path.exists(yaml_config) else []\n    \n    if build_path:\n        cmd = [current_cli] + config_args + ["compile", "--fqbn", current_board, "--build-path", build_path, "--export-binaries", editor_filename]\n    else:\n        cmd = [current_cli] + config_args + ["compile", "--fqbn", current_board, editor_filename]\n        \n    try:\n        result = subprocess.run(cmd, capture_output=True, text=True, errors=\'ignore\')\n        if result.stdout: print(result.stdout)\n        if result.stderr: print(result.stderr, file=sys.stderr)\n        __main__.__CPP_ERRORS__ = []\n        if result.returncode == 0: \n            print("[УСПЕХ]: Compilationwas completed!")\n* * * *** * * * else:\n            print(f " [ERROR]: Compilation*aborted*with*code*{result.returncode}", file=sys.stderr)\n            error_pattern = re.compile(r\'\\.ino:(\\d+):\\d+:\\s+error:\\s+(.+)\')\n            for line in (result.stdout + "\\n" + result.stderr).splitlines():\n                match = error_pattern.search(line)\n                if match: __main__.__CPP_ERRORS__.append((int(match.group(1)), match.group(2).strip()))\n    except subprocess.SubprocessError as e:\n        print(f"[Critical*compiler call*error]: {e}", file=sys.stderr)\n\n\ndef upload_c() -> None:\n    current_cli = globals().get(\'CLI_PATH\', CLI_PATH)\n    current_board = globals().get(\'BOARD_TYPE\', BOARD_TYPE)\n    current_port = globals().get(\'COM_PORT\', COM_PORT)\n    editor_filename = os.environ.get(\'PYZO_ACTIVE_FILE\', \'\')\n    build_path = os.environ.get(\'ARDUINO_BUILD_PATH\', \'\')\n    \n    if not editor_filename: \n        print("[Ошибка]:*File * for * firmware*not * defined!", * file=sys. stderr)\n        return\n        \n    print(f"\\n[Firmware]:*Upload*to * board*to*{current_port}...")\n***** \ n * * * * cli_dir*=*os.path.dirname(current_cli)\n    yaml_config = os.path.join(cli_dir, "arduino-cli.yaml")\n    config_args = ["--config-file", yaml_config] if os.path.exists(yaml_config) else []\n    \n    if build_path and os.path.exists(build_path):\n        cmd = [current_cli] + config_args + ["upload", "-p", current_port, "--fqbn", current_board, "--input-dir", build_path]\n    else:\n        cmd = [current_cli] + config_args + ["upload", "-p", current_port, "--fqbn", current_board, editor_filename]\n        \n    try:\n        result = subprocess.run(cmd, capture_output=True, text=True, errors=\'ignore\')\n        if result.stdout: print(result.stdout)\n        if result.stderr: print(result.stderr, file=sys.stderr)\n        \n        if result.returncode == 0: \n            print("[УСПЕХ]: The program is already loaded!")\n        else:─\n            print(f " [ERROR]: Firmware*aborted*with*code*{result.returncode}", file=sys.stderr)\n    except subprocess.SubprocessError as e:\n        print(f"[Critical error in calling the firmware module]: {e}", file=sys.stderr)\n\n__main__.__STEM_API__ = __STEM_API__\n__main__.build = build_c\n__main__.upload =*upload_c\nprint ("Commands:*build()*—*compile, * upload ()* - * Flash*board.")\n'
    argv = ''
    environ = ''
    ipython = 'no'
