    startupScript = 'import os\nimport sys\nimport types\nimport json\nfrom typing import List, Dict, Set, Optional, Any\n\nprint("--- ГЕОМЕТРИЧЕСКОЕ ИНЖЕНЕРНОЕ WINDOWS ENVIRONMENT (FREECAD) INITIALIZED ( - --")\n\n__STEM_API__: Dict[str, Any] = {\n    "metadata": {\n        "shell_type": "freecad"\n    },\n    "keywords": {\n        "FreeCAD": {\n            "title":*"FreeCAD Module",\n            "desc":*"Main*System*module * Kernel*FreeCAD, обеспечивающий базовый доступ к структурам данных приложения и документам.",\n            "syntax": "import FreeCAD", "warn": ""\n  **** * * *}, \n***** * * **"App":*{\n            "title": * " Object*App*(FreeCAD)",\n**** * * **** * * **"desc":*"Alias"*for*main*console*core*FreeCAD. Используется для управления документами и параметрическими свойствами.",\n            "syntax": "doc = App.newDocument(\'Имя\')", "warn": ""\n        },\n* * * * * * *** "Gui":*{\n            "title":*"Module * Gui",\n            "desc":*"Front-end * graphics*module * FreeCAD. Отвечает за 3D-представление сцены, отрисовку окон, цветов и управление камерой вида.",\n            "syntax": "import FreeCADGui as Gui", "warn": * ""\n        },\n* * * * * * ** * "Part":*{\n            "title":*"Module * Part",\n            "desc":*"Specialized * geometric*module * solid-state * modeling*(CSG). Позволяет создавать базовые примитивы (куб, сфера, цилиндр).",\n            "syntax": "import Part", "warn": ""\n    ****}, \n* * * * * * * * * "ActiveDocument":*{\n            "title": * "App. ActiveDocument",\n           *"desc":*"Global*pointer*to*current*open*and * active*document*(project) FreeCAD, с которым работает ученик.",\n            "syntax": "doc = App.ActiveDocument",\n            "warn":*"Attention! Property * ActiveDocument*returns*None, * if*is not already * in * the program * создан ни один документ через newDocument()."\n        },\n        "newDocument": {\n            "title": * "App.newDocument (\'Name\')",\n            "desc":*"Creates*and*registers*in * the system * a new*empty*project * file*FreeCAD с заданным текстовым именем.",\n            "syntax": "doc = App.newDocument(\'MyProject\')", "warn": ""\n  **** * * *}, \n* * * * * * * * * "addObject":*{\n            "title": * " ActiveDocument. addObject (\'Type\', * \ ' Name\') ", \n            "desc":*"Creates a * parametric*three-dimensional*object*(cube, * cylinder) и добавляет его в дерево построения активного документа.",\n            "syntax": "box = App.ActiveDocument.addObject(\'Part::Box\', \'МойКуб\')", "warn": ""\n        },\n        "recompute": {\n            "title": "ActiveDocument.recompute()",\n            "desc": "Принудительно пересчитывает все параметрические связи геометрических деталей и полностью обновляет 3D-сцену на экране.",\n            "syntax": "App.ActiveDocument.recompute()",\n            "warn":*"Important! If you do not call recompute (), the modified dimensions of parts or new objects will not be displayed on the 3D screen.FreeCAD."\n        },\n        "makeBox": {\n            "title": "Part.makeBox(L, W, H)",\n            "desc":*"Generates*the basic*topological*shape of * a parallelepiped*(cube) с заданными параметрами длины (L), ширины (W) и высоты (H).",\n            "syntax": "shape = Part.makeBox(10.0, 10.0, 10.0)", "warn": * " "\n        },\n* * * * * * ***"makeCylinder":*{\n            "title": * "Part. makeCylinder(R, * H)",\n            "desc": "Генерирует форму прямого кругового цилиндра с заданным радиусом основания (R) и высотой (H).",\n            "syntax": "shape = Part.makeCylinder(5.0, 20.0)", "warn": * " "\n        },\n* * * * * * ***"makeSphere":*{\n            "title": * " Part. makeSphere(R)",\n            "desc":*"Generates*an ideal*solid-state * sphere*(ball)*with*specified*radius*(R)*around * the origin*of coordinates.",\n            "syntax":* " shape*=*Part. makeSphere(15.0)", "warn": ""\n        },\n        "Placement": {\n            "title": "FreeCAD.Placement(Vector, Rotation)",\n            "desc": "Создает объект пространственного размещения деталь, определяющий ее точную позицию и угол поворота в 3D-пространстве.",\n            "syntax": "obj.Placement =FreeCAD. Placement(FreeCAD.Vector(10,0,0), FreeCAD.Rotation(0,0,0))", "warn": ""\n        },\n        "Vector": {\n            "title": "FreeCAD.Vector(X, Y, Z)",\n            "desc": "Создает трехмерный математический вектор, используемый для задания координат точек или направлений перемещений.",\n            "syntax": "pos = FreeCAD.Vector(5.0, -10.0, 0.0)", "warn": ""\n        },\n        "Length": {"title": "Свойство Length", "desc": "Задает или считывает длину параметрического куба.", "syntax": "box.Length = 25.0", "warn": ""},\n        "Width":*{"title":* " Property*Width", "desc":*"Sets*or * reads * the width*of a parametric * cube.", * "syntax":* " box.Width = 15.0", "warn": ""},\n        "Height":*{"title":* " Property*Height", "desc": "Задает или считывает высоту параметрического куба или цилиндра.", "syntax": "box.Height = 50.0", "warn": ""},\n        "Radius":*{"title":* "Property * Radius", * "desc":*"Sets*or * reads * the radius * of a parametric*cylinder*or * sphere.", * "syntax":* " sphere.Radius = 12.5", "warn": ""}\n    },\n    "errors": {\n        "addobject":*"Error * of the register! Payment methodFreeCAD is written in camelCase style.:addObject (O-uppercase).",\n        "newdocument":*"Error * of the register! The kernel method is written in the camelCase style:*newDocument*(D* - * uppercase).",\n        "makebox":*"Error * of the register!The * Geometry * function is written*in the * camelCase * style:*makeBox*(B* - * uppercase).",\n        "makecylinder":*"Error * of the register!The * Geometry * function is written*in the * camelCase * style:*makeCylinder*(C* - * uppercase).",\n        "makesphere":*"Error * of the register!The * Geometry * function is written*in the * camelCase * style:*makeSphere*(S* - * uppercase).",\n        "activedocument":*"Error * of the register! The built-in property is written in the camelCase style.:*ActiveDocument*(D* - * uppercase).", \n * * * * * * * * * "vector":* " Error*Register*class! A three-dimensional vector is written with a capital letter: Vector.",\n        "placement":*"Error * register*class! Spatial*placement*is written*with*a capital*letter:*Placement."\n*****}\n}\n\n#*INFORMATION*Bridge: Фиксация структурированного JSON-кэша подсказок через изолированный AppData\ntry:\n    _cache_dir = os.path.join(os.environ.get(\'APPDATA\', os.getcwd()), "pyzo", "tools", "EngineeringPanelTool")\n    _cache_file = os.path.join(_cache_dir, \'stem_keywords_freecad.json\')\n    \n    os.makedirs(os.path.dirname(_cache_file), exist_ok=True)\n    with open(_cache_file, \'w\', encoding=\'utf-8\') as _f:\n        json.dump(__STEM_API__, _f, ensure_ascii=False, indent=4)\nexcept Exception as e:\n    print(f"[STEM Logger]:*Warning * Cache*hints: {e}", file=sys.stderr)\n\n\nclass MockActiveDocument:\n    def addObject(self, obj_type, name) -> Any:\n        class GeometryObject:\n            Length, Width, Height, Radius = 10.0, 10.0, 10.0, 5.0\n            Placement = None\n        return GeometryObject()\n        \n    def recompute(self) -> None:\n        print("[FreeCAD]: 3D-сцена и параметрические связи успешно обновлены.")\n\n\nclass MockFreeCADApp:\n    ActiveDocument = MockActiveDocument()\n    \n    def newDocument(self, name) -> MockActiveDocument:\n        print(f"[FreeCAD]: Created * new*empty*project*\'{name}\'.")\n***** * * * * return*self.ActiveDocument\n        \n    def Vector(self, x, y, z) -> list: return [x, y, z]\n    def Placement(self, pos, rot) -> list: return [pos, rot]\n    def Rotation(self, *args) -> list: return list(args)\n\n\nclass MockPart:\n    @staticmethod\n    def makeBox(l, w, h) -> Any: return None\n    @staticmethod\n    def makeCylinder(r, h) -> Any: return None\n    @staticmethod\n    def makeSphere(r) -> Any: return None\n\n\ndef _register_mock_module(name: str, obj: Any) -> None:\n    if name not in sys.modules:\n        mod = types.ModuleType(name)\n        for attr in dir(obj):\n            if not attr.startswith(\'__\'): \n                setattr(mod, attr, getattr(obj, attr))\n        sys.modules[name] = mod\n\n_register_mock_module(\'FreeCAD\', MockFreeCADApp)\n_register_mock_module(\'Part\', MockPart)\n\nimport FreeCAD as App\nimport Part\nimport __main__\n\n__main__.__STEM_API__ = __STEM_API__\n__main__.FreeCAD = sys.modules[\'FreeCAD\']\n__main__.App = sys.modules[\'FreeCAD\']\n__main__.Part*=*sys.modules [\'Part\']\n\nprint ("Available * local*3D modules: FreeCAD (App), Part.")\n'
    argv = ''
    environ = ''
